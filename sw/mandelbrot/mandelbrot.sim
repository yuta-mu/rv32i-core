{
  int xmin, xmax, ymin, ymax;
  int width, height, maxiter;
  int shiftVal, oneVal, fourVal;
  int dx, dy;
  int row, col;
  int ci, cr, zr, zi, iter;
  int zr2, zi2, zrzi;
  int charIdx;

  // 定数初期化 (Q20.12固定小数点)
  shiftVal = 4096; // 1 << 12
  oneVal = shiftVal;
  fourVal = 4 * oneVal;

  width = 90;
  height = 30;
  maxiter = 64;

  xmin = (-21 * oneVal) / 10;
  xmax = (9 * oneVal) / 10;
  ymin = (-12 * oneVal) / 10;
  ymax = (12 * oneVal) / 10;

  dx = (xmax - xmin) / width;
  dy = (ymax - ymin) / height;

  sprint("\n--- RV32I Mandelbrot Demo (simc port) ---\n\n");

  row = 0;
  while (row < height) {
    ci = ymin + row * dy;
    col = 0;

    while (col < width) {
      cr = xmin + col * dx;
      zr = 0;
      zi = 0;
      iter = 0;

      while (iter < maxiter) {
        zr2 = (zr * zr) / shiftVal;
        zi2 = (zi * zi) / shiftVal;

        if (zr2 + zi2 > fourVal) {
          // breakが欲しい!!
          charIdx = (iter * 8) / maxiter;
          iter = maxiter + 100;
        } else {
          zrzi = (zr * zi) / shiftVal;
          zi = (zrzi * 2) + ci;
          zr = zr2 - zi2 + cr;
          iter++;
        }
      }

      // 収束判定とグラデーション描画
      if (iter == maxiter) {
        sprint("#");
      } else {
        if (charIdx <= 0) {
          sprint(" ");
        } else {
          if (charIdx == 1) {
            sprint(".");
          } else {
            if (charIdx == 2) {
              sprint(":");
            } else {
              if (charIdx == 3) {
                sprint("-");
              } else {
                if (charIdx == 4) {
                  sprint("=");
                } else {
                  if (charIdx == 5) {
                    sprint("+");
                  } else {
                    if (charIdx == 6) {
                      sprint("*");
                    } else {
                      sprint("%");
                    }
                  }
                }
              }
            }
          }
        }
      }

      col++;
    }
    sprint("\n");
    row++;
  }

  sprint("\n--- Done! ---\n");
}
